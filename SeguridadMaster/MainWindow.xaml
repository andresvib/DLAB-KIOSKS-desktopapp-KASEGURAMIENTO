<Window x:Class="SeguridadMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor de Seguridad de Sistema" 
        Height="500" Width="400" 
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Estado de Seguridad" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#333333"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <GroupBox Header="Estado de los Controles" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Border x:Name="ledRegistry" Style="{StaticResource StatusLed}"/>
                            <TextBlock Text="Políticas de Registro Aplicadas" Style="{StaticResource StatusText}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Border x:Name="ledFirewall" Style="{StaticResource StatusLed}"/>
                            <TextBlock Text="Reglas de Firewall Activas" Style="{StaticResource StatusText}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Border x:Name="ledWifi" Style="{StaticResource StatusLed}"/>
                            <TextBlock Text="Bloqueo de Adaptadores WiFi" Style="{StaticResource StatusText}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <Border x:Name="ledHook" Style="{StaticResource StatusLed}"/>
                            <TextBlock Text="Bloqueo Global de Teclado" Style="{StaticResource StatusText}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="Progreso de Activación:" FontSize="11" Foreground="#666666" Margin="0,5,0,2"/>
                <ProgressBar x:Name="pgBar" Height="12" Minimum="0" Maximum="100" Value="0" 
                             Foreground="#28a745" Background="#DCDCDC" BorderThickness="0"/>

                <Separator Margin="0,20,0,15"/>

                <Button x:Name="btnIniciar" 
                        Content="ACTIVAR ESCUDO DE SEGURIDAD" 
                        Click="OnStartProtection" 
                        Height="55" 
                        Background="#1e7e34" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="14"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnUsbControl" 
                        Content="USB: PERMITIDO" 
                        Click="OnUsbControl_Click" 
                        Background="ForestGreen" 
                        Foreground="White"
                        FontWeight="Bold"
                        Height="45"
                        Margin="0,10,0,0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="Emergencia: Ctrl + Shift + Alt + K" 
                           HorizontalAlignment="Center" 
                           Foreground="#D32F2F" 
                           FontWeight="SemiBold"
                           Margin="0,20,0,0" 
                           FontSize="11"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>